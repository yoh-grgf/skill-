{
  "$schema": "internal://ai-ui-forge/tokens-1",
  "meta": {
    "preset": "dark-console",
    "presetName": "深色工作台",
    "density": "compact",
    "generatedBy": "ai-ui-forge/scripts/tokens.py",
    "rule": "组件只允许消费这里的 token，不许写死 hex / px"
  },
  "color": {
    "light": {
      "bg": "#F4F6F9",
      "surface": "#FFFFFF",
      "surfaceAlt": "#EDF1F6",
      "border": "#DCE2EB",
      "text": "#0E1420",
      "muted": "#586172",
      "primary": "#2F81F7",
      "accent": "#2F81F7",
      "success": "#2DA44E",
      "warning": "#BF8700",
      "danger": "#CF3B3B"
    },
    "dark": {
      "bg": "#0D1117",
      "surface": "#161B22",
      "surfaceAlt": "#1C2230",
      "border": "#2A313C",
      "text": "#E6EDF3",
      "muted": "#8B949E",
      "primary": "#4C9AFF",
      "accent": "#4C9AFF",
      "success": "#3FB950",
      "warning": "#D29922",
      "danger": "#F85149"
    }
  },
  "typography": {
    "latin": "Inter, ui-sans-serif, system-ui",
    "cn": "\"PingFang SC\", \"Microsoft YaHei\", \"Source Han Sans SC\", sans-serif",
    "display": {
      "size": 48,
      "lineHeight": 1.1,
      "weight": 700,
      "tracking": "-0.02em"
    },
    "h1": {
      "size": 34,
      "lineHeight": 1.2,
      "weight": 650,
      "tracking": "-0.015em"
    },
    "h2": {
      "size": 24,
      "lineHeight": 1.3,
      "weight": 600,
      "tracking": "0"
    },
    "body": {
      "size": 15,
      "lineHeight": 1.6,
      "weight": 400,
      "tracking": "0"
    },
    "caption": {
      "size": 12,
      "lineHeight": 1.5,
      "weight": 500,
      "tracking": "0.03em"
    },
    "mono": "\"JetBrains Mono\", ui-monospace, SFMono-Regular, Menlo, monospace"
  },
  "space": {
    "s1": 4,
    "s2": 8,
    "s3": 12,
    "s4": 16,
    "s5": 24,
    "s6": 32,
    "s7": 48,
    "s8": 64,
    "s9": 96
  },
  "radius": {
    "sm": 6,
    "md": 10,
    "pill": 999
  },
  "shadow": {
    "card": "0 0 0 1px rgba(255,255,255,.04)",
    "overlay": "0 18px 48px -18px rgba(0,0,0,.7)"
  },
  "motion": {
    "fast": 100,
    "base": 180,
    "slow": 280,
    "easing": "cubic-bezier(.4,0,.2,1)"
  },
  "breakpoints": {
    "sm": 640,
    "md": 768,
    "lg": 1024,
    "xl": 1280
  },
  "semantic": {
    "focusRing": "2px solid color-mix(in oklab, token(color.primary) 70%, white)",
    "borderSubtle": "color-mix(in oklab, token(color.border) 60%, transparent)",
    "textOnPrimary": "white"
  },
  "components": {
    "button": {
      "height": {
        "sm": 32,
        "md": 40,
        "lg": 48
      },
      "paddingX": {
        "sm": 12,
        "md": 16,
        "lg": 24
      },
      "radius": "token(radius.sm)",
      "states": [
        "default",
        "hover",
        "active",
        "focus-visible",
        "disabled"
      ],
      "transition": "token(motion.fast) token(motion.easing)"
    },
    "input": {
      "height": 40,
      "radius": "token(radius.sm)",
      "states": [
        "default",
        "focus",
        "error",
        "disabled"
      ]
    },
    "card": {
      "radius": "token(radius.md)",
      "shadow": "token(shadow.card)",
      "padding": "token(space.s5)"
    },
    "badge": {
      "height": 24,
      "radius": "token(radius.pill)",
      "paddingX": "token(space.s2)"
    }
  },
  "a11y": {
    "minContrastBody": 4.5,
    "minContrastLarge": 3.0,
    "minTargetSize": 44,
    "reducedMotion": "prefers-reduced-motion: 关闭位移/缩放，仅保留透明度变化"
  },
  "avoid": [
    "暗色里用纯黑底",
    "大面积渐变",
    "把强调色用于正文"
  ]
}
